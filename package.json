{
  "name": "bipodmukti",
  "version": "0.1.0",
  "private": true,
  "description": "Safety check-ins for basic phones during floods and cyclones, built on Applink (SMS, USSD, Subscription, OTP).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "demo": "SIMULATOR_ENABLED=true ACK_TIMEOUT_SECONDS=45 SCHEDULER_TICK_SECONDS=2 DATABASE_PATH=data/demo.db node src/server.ts",
    "demo:reset": "rm -f data/demo.db data/demo.db-shm data/demo.db-wal",
    "dev": "SIMULATOR_ENABLED=true node --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "SIMULATOR_ENABLED=true LOG_LEVEL=silent node --test --test-reporter=spec test/*.test.ts",
    "conformance": "node scripts/conformance.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
