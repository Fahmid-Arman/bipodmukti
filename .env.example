# BipodMukti configuration. Copy to .env (git-ignored) and fill in.
# Never commit real credentials. Never prefix these with NEXT_PUBLIC_/VITE_ etc.

PORT=3000
PUBLIC_BASE_URL=https://your-app.example.com
DATABASE_PATH=data/bipodmukti.db
LOG_LEVEL=info

# Password for the coordinator console (/console). Leave empty only for local demos.
DASHBOARD_PASSWORD=

# true = built-in simulated Applink network + virtual phones at /simulator.
# false = talk to the real Applink platform with the credentials below.
SIMULATOR_ENABLED=false
SEED_DEMO=false

# ── Applink credentials (from user.applink.com.bd after approval) ─────────
APPLINK_APP_ID=APP_XXXXXX
APPLINK_PASSWORD=

# ── One URL per Applink API enabled on the app. Unset = not enabled. ─────
APPLINK_SMS_SEND_URL=https://api.applink.com.bd/sms/send
APPLINK_USSD_SEND_URL=https://api.applink.com.bd/ussd/send
APPLINK_SUBSCRIPTION_SEND_URL=https://api.applink.com.bd/subscription/send
APPLINK_SUBSCRIPTION_QUERY_BASE_URL=https://api.applink.com.bd/subscription/query-base
APPLINK_SUBSCRIPTION_CHARGING_INFO_URL=https://api.applink.com.bd/subscription/getSubscriberChargingInfo
APPLINK_OTP_REQUEST_URL=https://api.applink.com.bd/otp/request
APPLINK_OTP_VERIFY_URL=https://api.applink.com.bd/otp/verify

# ── Values Applink assigns during provisioning ───────────────────────────
APPLINK_SMS_KEYWORD=BIPOD
APPLINK_SMS_SHORTCODE=21213
APPLINK_USSD_CODE=*213*55#
# Provisioned sender alias; leave empty to use the platform default.
APPLINK_SMS_SOURCE_ADDRESS=
# Ask for delivery reports (needs the report callback URL registered).
APPLINK_DELIVERY_REPORTS=true
# Allow tel:all broadcast to the whole subscriber base.
APPLINK_ALLOW_BROADCAST=false
# Shown to people before they subscribe.
SUBSCRIPTION_TERMS=Free during the pilot

# ── Escalation timing ─────────────────────────────────────────────────────
ACK_TIMEOUT_SECONDS=180
SCHEDULER_TICK_SECONDS=5
ROLL_CALL_DEFAULT_MINUTES=30

# ── Live demo with real whitelisted SIMs (used only when seeding) ─────────
# DEMO_MEMBER_NUMBER=019XXXXXXXX
# DEMO_FAMILY1_NUMBER=019XXXXXXXX
# DEMO_FAMILY2_NUMBER=014XXXXXXXX
# DEMO_VOLUNTEER_NUMBER=019XXXXXXXX
